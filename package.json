{
  "name": "jscrawlers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node.js crawlers monorepo — one folder per crawler",
  "workspaces": [
    "packages/*",
    "crawlers/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "crawl": "node scripts/run.mjs",
    "new": "node scripts/new-crawler.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  }
}
