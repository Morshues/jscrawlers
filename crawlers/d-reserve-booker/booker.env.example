# d-reserve-booker — the ONLY place booking secrets live.
#
# Copy this file OUT of the repository and lock it down:
#   mkdir -p ~/.config/d-reserve-booker
#   cp booker.env.example ~/.config/d-reserve-booker/booker.env
#   chmod 600 ~/.config/d-reserve-booker/booker.env
# main.js refuses to start if the file is inside the repo or readable by others.

# ---- HTTP: how the watcher reaches this machine ------------------------------
# 127.0.0.1 only accepts local calls; use this machine's Tailscale/LAN IP to let
# the watcher in. Never bind a public interface.
BOOKER_LISTEN=127.0.0.1:8787
# Shared with the watcher's DRESERVE_BOOKER_SECRET. At least 32 characters:
#   openssl rand -hex 32
BOOKER_SECRET=
# false = accept requests but only rehearse (log in, build the booking, send
# nothing). Set true once a rehearsal has been seen working end to end.
BOOKER_SUBMIT=false

# ---- Which hotel and party ----------------------------------------------------
BOOKER_API_BASE=https://d-reserve.jp
BOOKER_HOTEL_CODE=0000001834
BOOKER_LODGER_CODE=0_1_2_3_4_6
BOOKER_LODGER_NUM=2_0_0_0_0_0
BOOKER_STAYS=1

# ---- Policy: what this machine agrees to book --------------------------------
# The watcher only reports open rooms; these decide what is actually booked.
# Required. Dates and inclusive ranges: 2026-10-29,2026-11-01..2026-11-03
BOOKER_DATES=
# Blank = any room type on those dates.
BOOKER_ROOM_CODES=
# Required. Yen, whole stay. Checked against the calendar price and again
# against the booking page's own total before submitting.
BOOKER_MAX_PRICE=
# Failed submissions per room/date before giving up on it.
BOOKER_MAX_ATTEMPTS=3

# ---- Who is booking ------------------------------------------------------------
BOOKER_LOGIN_USER=
BOOKER_LOGIN_PASSWORD=
# The hotel's questionnaire, <code>=<value>. The error message lists the
# questions and choices if a required one is missing. 8153=0 is 公共交通機関.
BOOKER_ANSWERS=8153=0
# How many of the adults are male / female; the rest are booked as "other".
BOOKER_ADULT_MALES=0
BOOKER_ADULT_FEMALES=0

# ---- Where results go (straight to you, never back to the watcher) ------------
# telegram | webhook | command, comma-separated.
BOOKER_NOTIFY_CHANNELS=telegram
# Send-only here, so sharing the watcher's bot is fine; a separate bot keeps the
# payment link out of a chat the watcher's operator might read.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
