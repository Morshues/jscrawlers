# buy-gamer-tw 自動下單的私密設定。放在 repo 外面：
#   mkdir -p ~/.config/buy-gamer-tw
#   cp crawlers/buy-gamer-tw/order.env.example ~/.config/buy-gamer-tw/order.env
#   chmod 600 ~/.config/buy-gamer-tw/order.env
# 放在 repo 內、或權限不是 600 的話，程式會拒絕執行。

# ─── 登入（兩種擇一，都填則先試 cookie）─────────────────────────────────────────
# 巴哈登入頁有 reCAPTCHA。帳密登入不帶驗證碼，巴哈若要求驗證就會失敗，那時請改用 cookie。
BUYGAMER_LOGIN_USER=
BUYGAMER_LOGIN_PASSWORD=
# 在瀏覽器登入一次（勾「保持登入狀態」），開發者工具 → Application → Cookies →
# https://www.gamer.com.tw，複製這三個：
# BUYGAMER_COOKIES=BAHAID=yourid; BAHARUNE=...; BAHAENUR=...
BUYGAMER_COOKIES=

# ─── 下單 ─────────────────────────────────────────────────────────────────────
# 必填。商品價格（之後是訂單總額）超過這個數字就不下單（新台幣）。
BUYGAMER_ORDER_MAX_PRICE=
# 確認頁核對無誤後是否真的送出訂單。先維持 false，看過一次確認頁沒問題再改 true。
BUYGAMER_ORDER_SUBMIT=false
