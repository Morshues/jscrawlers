# Copy to .env — loaded automatically by `npm run crawl` (Node --env-file-if-exists).

# debug | info | warn | error | silent
LOG_LEVEL=info

# Override the default browser-ish User-Agent for every request
# USER_AGENT=

# Where crawler output goes (default: <repo>/data)
# DATA_ROOT=


# ─── d-reserve-jp: what to watch ──────────────────────────────────────────────
DRESERVE_API_BASE=https://d-reserve.jp
DRESERVE_HOTEL_CODE=0000001834
DRESERVE_FROM_DATE=2026-09-10
DRESERVE_TO_DATE=2026-11-15

# Party size. lodgerNum genuinely changes the answer: it filters room types by
# capacity and shifts prices, so it must match what you would actually book.
# Slots line up with lodgerCode; the first is adults.
DRESERVE_LODGER_CODE=0_1_2_3_4_6
DRESERVE_LODGER_NUM=2_0_0_0_0_0
DRESERVE_STAYS=1
DRESERVE_ONLY_ALL_LANGUAGES_PLAN=false
DRESERVE_ONLY_ALL_RANK_PLAN=false

# ─── polling ──────────────────────────────────────────────────────────────────
# Only used by resident mode (--interval); one-shot runs ignore it.
DRESERVE_INTERVAL=5m
# Gap between the month windows of a single poll.
DRESERVE_REQUEST_DELAY_MS=1500
# Keep gzipped raw responses so a future analysis can be re-run over old data.
DRESERVE_KEEP_RAW=false
DRESERVE_RAW_KEEP=48
# Release times are grouped in this timezone — the hotel's, not yours.
DRESERVE_REPORT_TZ=Asia/Tokyo

# ─── what you want to book (phase 2; blank = do not restrict) ─────────────────
# Single dates and inclusive A..B ranges, comma-separated and mixable.
DRESERVE_WATCH_DATES=
# e.g. RM00010235,RM00010241 — see `npm run crawl d-reserve-jp -- --dry-run`
DRESERVE_WATCH_ROOM_CODES=
# Substring of the room name, e.g. 露天風呂付
DRESERVE_WATCH_ROOM_NAME=
# e.g. FRIDAY,SATURDAY
DRESERVE_WATCH_DAYS_OF_WEEK=
# Compared against lowestPlanForMember.totalPrice (yen, whole stay)
DRESERVE_WATCH_MAX_PRICE=
DRESERVE_WATCH_MIN_STOCK=1

# ─── notifications ────────────────────────────────────────────────────────────
# Comma-separated: webhook, telegram, command. Blank = log only.
DRESERVE_NOTIFY_CHANNELS=
# 0 = alert once per opening; >0 = re-alert every N minutes while it stays open.
DRESERVE_NOTIFY_COOLDOWN_MIN=0
# true = one message covering every match in a poll; false = one per match.
DRESERVE_NOTIFY_GROUPED=true
# The first run has no baseline, so anything already open is not a release and is
# only logged. Set true to be alerted about it anyway.
DRESERVE_NOTIFY_ON_FIRST_RUN=false
# d-reserve.jp is API-only (its own / is a 404), so the booking page lives on the
# hotel's site. Paste the URL you would actually book through.
DRESERVE_BOOKING_URL=

NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_METHOD=POST
NOTIFY_WEBHOOK_HEADERS=
# NOTIFY_WEBHOOK_HEADERS={"Authorization":"Bearer xxx"}

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runs via `sh -c`, with the JSON payload on stdin. For a clawbot CLI, a script
# that forwards to a session, or `cat >> /tmp/notify.log` while testing.
NOTIFY_COMMAND=
NOTIFY_COMMAND_TIMEOUT_MS=15000

# ─── daily digest (--daily-summary) ───────────────────────────────────────────
# Each digest covers a fixed half-open window: [previous day HH:00, today HH:00).
# An event at exactly the boundary belongs to the next window, so every event
# lands in exactly one digest. Windows come from a checkpoint, not from "now",
# so a sleeping Mac or a missed schedule is backfilled rather than lost.
DRESERVE_DAILY_TZ=Asia/Taipei
DRESERVE_DAILY_HOUR=20
# Blank = reuse DRESERVE_NOTIFY_CHANNELS.
DRESERVE_DAILY_CHANNELS=
# Cap on how many windows one run will backfill; older ones are skipped with a
# note in the first message.
DRESERVE_DAILY_MAX_BACKFILL=7
# Split threshold. Telegram's own limit is 4096; the headroom covers the title
# and HTML escaping.
DRESERVE_DAILY_MAX_CHARS=3500


# ─── buy-gamer-tw: 巴哈商城補貨監看 ────────────────────────────────────────────
# 要監看的商品。可用商品編號 (sn) 或直接貼商品網址，逗號分隔、可混用。
# 例：BUYGAMER_ITEMS=42810,https://buy.gamer.com.tw/atmItem.php?sn=41435
BUYGAMER_ITEMS=
BUYGAMER_BASE_URL=https://buy.gamer.com.tw

# ─── 輪詢 ─────────────────────────────────────────────────────────────────────
# 只有常駐模式 (--interval) 會用到；一次性執行會忽略。
BUYGAMER_INTERVAL=5m
# 同一輪之中，商品與商品之間的間隔。
BUYGAMER_REQUEST_DELAY_MS=1500
# 保留 gzip 原始 HTML，版面改版導致解析失敗時可以回頭比對。
BUYGAMER_KEEP_RAW=false
BUYGAMER_RAW_KEEP=48

# ─── 頁面判讀 ─────────────────────────────────────────────────────────────────
# 限制級商品會被導去 warn.php，帶上 18 禁 cookie 才看得到商品頁。
BUYGAMER_ADULT_COOKIE=true
# 購買按鈕出現這些字 = 可以下單。留白 = 加入購物車,前往預購,前往購買
# （已發售的商品是「前往購買」，預購中才是「前往預購」，兩個都要看。）
BUYGAMER_BUY_KEYWORDS=
# 出現這些字 = 售罄。留白 = 補貨通知我
BUYGAMER_SOLD_OUT_KEYWORDS=

# ─── 通知 ─────────────────────────────────────────────────────────────────────
# 逗號分隔：webhook, telegram, command。留白 = 只寫 log。
# 實際管道設定沿用上面的 NOTIFY_* / TELEGRAM_* 變數。
BUYGAMER_NOTIFY_CHANNELS=
# 0 = 每次開放只通知一次；>0 = 開放期間每 N 分鐘再提醒一次。
BUYGAMER_NOTIFY_COOLDOWN_MIN=0
# true = 一則訊息涵蓋本輪所有商品；false = 一件一則。
BUYGAMER_NOTIFY_GROUPED=true
# 首次觀測到的商品沒有基準線，就算當下可下單也分不出是「剛開放」還是「一直都能買」，
# 預設只寫進 log。設 true 則連這些也通知。
BUYGAMER_NOTIFY_ON_FIRST_RUN=false
